@page "/annoncer"
@inject AnnonceService annonceService
@using Blazor.Components  @* Tilpas navnet *@

<h3>Alle annoncer</h3>

@if (annoncer == null)
{
    <p>Indlæser annoncer...</p>
}
else if (!annoncer.Any())
{
    <p>Der er endnu ingen annoncer.</p>
}
else
{
    <div class="cards-container">
        @foreach (var annonce in annoncer)
        {
            <AnnonceCard Annonce="annonce" />
        }
    </div>
}

@code {
    private List<Annonce> annoncer;

    protected override async Task OnInitializedAsync()
    {
        annoncer = await annonceService.HentAlleAnnoncer();
    }
}

<style>
.cards-container {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
}
</style>