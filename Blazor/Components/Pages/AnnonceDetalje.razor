@page "/annonce/{id:int}"
@rendermode InteractiveServer
@inject AnnonceService annonceService


<h3>Annonce Detaljer</h3>

@if (annonce == null)
{
    <p>Indlæser...</p>
}
else
{
    <div class="card" style="max-width:500px;">
        <div class="card-body">
            <h2>@annonce.Titel</h2>
            <p>@annonce.Beskrivelse</p>
            <p><strong>Pris:</strong> @annonce.Pris.ToString("0.00") kr.</p>
            <p><strong>Oprettet:</strong> @annonce.Oprettet.ToString("dd-MM-yyyy HH:mm")</p>
            <p><strong>Listed by: </strong> @annonce.UserId</p>
        </div>
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }
    public Annonce annonce;

    protected override async Task OnInitializedAsync()
    {
        annonce = await annonceService.HentAnnonceVedId(id);
    }
}