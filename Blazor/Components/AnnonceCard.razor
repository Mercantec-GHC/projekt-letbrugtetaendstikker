@using System.Globalization
@inherits OwningComponentBase

@* Modtag en annonce som parameter *@
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@if (Annonce.Image != null)
{
    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Annonce.Image)" alt="Image" style="max-width:200px;max-height:200px;" />
}
@if (Annonce.User != null)
{
    <div class="user">Oprettet af: @Annonce.User.Username</div>
}

<div class="card" @onclick="ÅbenAnnonce" style="cursor:pointer">
    <div class="card-body">
        <h4>@Annonce.Titel</h4>
        <p>@Annonce.Beskrivelse</p>
        <div class="card-footer">
            <span class="pris">@Annonce.Pris.ToString("0.00") kr.</span>
            <span class="dato">@Annonce.Oprettet.ToString("dd-MM-yyyy HH:mm")</span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Annonce Annonce { get; set; }

    private void ÅbenAnnonce()
    {
        NavigationManager.NavigateTo($"/annonce/{Annonce.Id}");
    }
}
